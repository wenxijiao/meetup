# Copy this file to .streamlit/secrets.toml for local development, or paste
# its contents into Streamlit Community Cloud: App settings -> Secrets.
# Never commit real values.

# Paste the complete downloaded service-account JSON between the triple quotes.
# Triple single quotes preserve the JSON's escaped newlines in `private_key`.
FIREBASE_SERVICE_ACCOUNT_JSON = '''{
  "type": "service_account",
  "project_id": "your-firebase-project-id",
  "private_key_id": "replace-with-private-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n",
  "client_email": "meetup-demo-app@your-firebase-project-id.iam.gserviceaccount.com",
  "client_id": "replace-with-client-id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/replace-with-url-encoded-client-email",
  "universe_domain": "googleapis.com"
}'''

[auth]
admin_password = "replace-with-a-strong-admin-password"
cashier_password = "replace-with-a-strong-cashier-password"
cookie_signing_secret = "replace-with-a-separate-random-secret"
